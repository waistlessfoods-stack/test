    "fallow:list:entry-points": "fallow list --entry-points",
    "fallow:audit": "fallow audit --base main --gate new-only",
    "fallow:audit:ci": "fallow audit --base origin/main --gate new-only --quiet",
    "contentful:seed": "node scripts/contentful/seed-services.mjs",
    "contentful:seed-homepage": "node scripts/contentful/seed-homepage.mjs",
    "contentful:seed-footer-settings": "node scripts/contentful/seed-footer-settings.mjs",

{
  "name": "waistlessfood.com",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "next dev",
    "email:dev": "email dev --dir lib/email/templates --port 3001",
    "killdev": "pkill -f 'next dev|next-server' || true; rm -f .next/dev/lock",
    "restart": "pnpm killdev && pnpm dev",
